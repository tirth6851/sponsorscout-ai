# Supabase — public vars safe for browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Groq — server-only, never expose to client
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Job ingestion secret — protects POST /api/jobs/ingest from any authenticated user
# Generate with: openssl rand -hex 32
INGEST_SECRET=

# Job ingestion APIs — server-only, never expose to client
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# SerpApi: https://serpapi.com/
SERPAPI_API_KEY=
# USAJobs: https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
